{
  "expo": {
    "name": "Pathie",
    "slug": "pathie-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#9333EA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pathie.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pathie needs your location to find nearby activities for your children."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#9333EA"
      },
      "package": "com.pathie.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Pathie",
      "shortName": "Pathie",
      "description": "Fun activities for every dream - plan and schedule activities aligned with your child's goals.",
      "themeColor": "#9333EA"
    }
  }
}